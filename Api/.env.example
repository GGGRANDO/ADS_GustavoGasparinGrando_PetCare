PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=petcare
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=petcare_secret_change_in_production

# Configurações de e-mail (SMTP) para redefinição de senha
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM=PetCare <seu_email@gmail.com>

# Asaas – integração de pagamentos
# Sandbox:    https://sandbox.asaas.com/api/v3
# Produção:   https://www.asaas.com/api/v3
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=sua_chave_asaas_aqui
